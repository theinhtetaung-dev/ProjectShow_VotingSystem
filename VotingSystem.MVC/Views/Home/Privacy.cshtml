@{
    ViewData["Title"] = "Security & Governance";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Governance / Policy</span>
            <h1>Security &amp; Data Integrity</h1>
            <p>Cryptographic standards, ballot privacy and system verification protocols.</p>
        </div>
    </div>

    <div class="panel material">
        <div class="card-head">
            <div>
                <h3 class="h5 mb-1"><i class="fa-solid fa-shield-halved text-info me-2"></i> Precision Voting Infrastructure</h3>
                <p class="text-sub small">Cryptographically verified election cycles for innovation challenges.</p>
            </div>
        </div>
        <div class="mt-3 text-sub small" style="line-height:1.8">
            <p>NEXUS Vote ensures that every submitted ballot is authenticated against verified participant identity tokens. Tally results remain immutable and verifiable by both contest adjudicators and competing team representatives.</p>
            <p>Participation credentials and event passwords are encrypted using industry-standard hashing algorithms with session token expiration safeguards.</p>
        </div>
    </div>
</div>
