@model List<UserResponseModel>
@{ ViewData["Title"] = "Users"; }
<div class="page-toolbar mb-3"><div><p class="eyebrow mb-1">Access management</p><h1 class="h2 mb-0">Users</h1></div><a asp-action="Create" class="btn btn-primary"><svg class="app-icon"><use href="#icon-plus" /></svg>Create user</a></div>
<partial name="_PageAlerts" />
@if (Model.Count == 0) { <div class="alert alert-info">No users found.</div> } else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Name</th><th>Email</th><th>Role ID</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Name"><strong>@item.Name</strong></td><td data-label="Email"><a href="mailto:@item.Email">@item.Email</a></td><td data-label="Role ID">@item.RoleId</td><td data-label="Actions" class="table-actions text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }</tbody></table></div> }
