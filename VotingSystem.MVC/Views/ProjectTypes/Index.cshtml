@model PageResult<ProjectTypeResponseModel>
@{
    ViewData["Title"] = "Project Types";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Workspace / Categories</span>
            <h1>Project types</h1>
            <p>Classification tracks and technology disciplines for competition entries.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            <span>Add project type</span>
        </a>
    </div>

    @if (Model == null || Model.Items.Count == 0)
    {
        <div class="panel material text-center p-5">
            <i class="fa-solid fa-shapes fa-2x mb-3 text-muted"></i>
            <h3 class="h5 mb-2">No project types found</h3>
            <p class="text-muted small">Create categories such as Software, Hardware, AI, or Cybersecurity.</p>
        </div>
    }
    else
    {
        <div class="table-shell material">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Category name</th>
                            <th>Code</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var lower = item.Name?.ToLowerInvariant() ?? "";
                            var isAi = lower.Contains("ai");
                            var isHard = lower.Contains("hard");
                            var isCyber = lower.Contains("cyber") || lower.Contains("sec");
                            var tagCls = isAi ? "ai" : (isHard ? "hardware" : (isCyber ? "cyber" : "software"));

                            <tr>
                                <td>
                                    <span class="tag @tagCls me-2">@item.Name</span>
                                </td>
                                <td>
                                    <span class="badge" style="font-family:monospace">@item.Code</span>
                                </td>
                                <td>
                                    <div class="row-actions justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" title="Edit type">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" title="Delete type">
                                            <i class="fa-regular fa-trash-can text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model" />
        </div>
    }
</div>
