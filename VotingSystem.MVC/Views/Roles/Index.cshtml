@model PageResult<RoleResponseModel>
@{ ViewData["Title"] = "Roles"; }
<div class="page-toolbar mb-3"><div><p class="eyebrow mb-1">Authorization</p><h1 class="h2 mb-0">Roles</h1></div><a asp-action="Create" class="btn btn-primary"><svg class="app-icon"><use href="#icon-plus" /></svg>Create role</a></div>
<partial name="_PageAlerts" />
@if (Model.Count == 0) { <div class="alert alert-info">No roles found.</div> } else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Role</th><th>Description</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Role"><strong>@item.Name</strong></td><td data-label="Description">@(item.Description ?? "—")</td><td data-label="Actions" class="table-actions text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model="Model" />
