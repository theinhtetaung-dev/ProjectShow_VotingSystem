@model EventResponseModel
@{
    ViewData["Title"] = "Delete Event";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow text-danger">Workspace / Events / Danger Zone</span>
            <h1 class="text-danger">Delete event</h1>
            <p>Confirm the permanent removal of this event from the platform.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to list</span>
        </a>
    </div>

    <div class="panel material" style="border-color:rgba(251,113,133,0.3)">
        <h3 class="h5 mb-3">Are you sure you want to delete this event?</h3>
        <dl class="row detail-list mb-4">
            <dt class="col-sm-3">Event Name</dt>
            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>
            <dt class="col-sm-3">Event Code</dt>
            <dd class="col-sm-9"><span class="badge" style="font-family:monospace">@Model.Code</span></dd>
            <dt class="col-sm-3">Event Window</dt>
            <dd class="col-sm-9">@Model.EventStartAt.ToString("dd MMM yyyy") – @Model.EventEndAt.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Current Status</dt>
            <dd class="col-sm-9"><span class="badge ended-b">@Model.Status</span></dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"
              data-confirm-title="Delete event?" 
              data-confirm-message="This will permanently delete @Model.Name and associated allocations. This action cannot be undone." 
              data-confirm-button-text="Yes, delete event">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="fa-regular fa-trash-can"></i>
                <span>Permanently delete</span>
            </button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
