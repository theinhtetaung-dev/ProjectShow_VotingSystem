@model EventResponseModel
@{
    ViewData["Title"] = "Delete Event";
}

<h1 class="h2 text-danger">Delete event</h1>
<div class="alert alert-warning">Are you sure you want to delete this event?</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.Code</dd>
    <dt class="col-sm-3">Event dates</dt><dd class="col-sm-9">@Model.EventStartAt.ToString("g") – @Model.EventEndAt.ToString("g")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
