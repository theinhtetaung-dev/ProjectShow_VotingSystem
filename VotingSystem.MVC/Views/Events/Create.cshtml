@model EventCreateRequestModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="page-header mb-4"><div><p class="eyebrow mb-1">Event management</p><h1 class="h2 mb-0">Create event</h1></div></div>
<form asp-action="Create" method="post" class="content-form">
    <partial name="_Form" model="Model" />
    <div class="form-actions mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
