@model EventCreateRequestModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Workspace / Events / New</span>
            <h1>Create event</h1>
            <p>Schedule a new innovation challenge, voting window and outcomes.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Cancel</span>
        </a>
    </div>

    <div class="panel material">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i>
                    <span>Create event</span>
                </button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
