@model EventUpdateRequestModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Workspace / Events / Modify</span>
            <h1>Edit event</h1>
            <p>Modify contest schedules, codes, and operational status.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to list</span>
        </a>
    </div>

    <div class="panel material">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i>
                    <span>Save changes</span>
                </button>
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
