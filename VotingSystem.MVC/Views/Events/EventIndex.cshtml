@model PageResult<EventResponseModel>
@{
    ViewData["Title"] = "Events";
}

<div class="page-toolbar mb-3">
    <h1 class="h2 mb-0">Events</h1>
    <a asp-action="Create" class="btn btn-primary"><svg class="app-icon"><use href="#icon-plus" /></svg><span>Create event</span></a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No events found.</div>
}
else
{
    <div class="table-responsive mobile-table-shell">
        <table class="table table-striped table-hover align-middle mobile-card-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Event dates</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td data-label="Name"><strong class="mobile-primary">@item.Name</strong></td>
                    <td data-label="Code">@item.Code</td>
                    <td data-label="Event dates"><span class="date-range"><span>@item.EventStartAt.ToString("g")</span><span aria-hidden="true">–</span><span>@item.EventEndAt.ToString("g")</span></span></td>
                    <td data-label="Status"><span class="badge bg-secondary">@item.Status</span></td>
                    <td data-label="Actions" class="table-actions text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" aria-label="View @item.Name"><svg class="app-icon"><use href="#icon-eye" /></svg><span>Details</span></a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit @item.Name"><svg class="app-icon"><use href="#icon-edit" /></svg><span>Edit</span></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" aria-label="Delete @item.Name"><svg class="app-icon"><use href="#icon-trash" /></svg><span>Delete</span></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
}
