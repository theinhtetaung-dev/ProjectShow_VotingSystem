@model PageResult<ResultResponseModel>
@{
    ViewData["Title"] = "Results";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Ballot / Results</span>
            <h1>Audited contest outcomes</h1>
            <p>Official verified tally summaries and leaderboard release records.</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                <span>Publish result</span>
            </a>
        }
    </div>

    @if (Model == null || Model.Items.Count == 0)
    {
        <div class="panel material text-center p-5">
            <i class="fa-solid fa-trophy fa-2x mb-3 text-muted"></i>
            <h3 class="h5 mb-2">No published results</h3>
            <p class="text-muted small">Contest tally calculations will be displayed here once finalized and published.</p>
        </div>
    }
    else
    {
        <div class="table-shell material">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Event ID</th>
                            <th>Winning Project</th>
                            <th>Status</th>
                            <th>Version</th>
                            <th>Published date</th>
                            @if (canManage)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var statusStr = item.Status.ToString().Replace('_', ' ');
                            <tr>
                                <td>
                                    <span class="badge" style="font-family:monospace">Event #@item.EventId</span>
                                </td>
                                <td>
                                    <strong>Project #@item.ProjectId</strong>
                                </td>
                                <td>
                                    <span class="badge published-b">@statusStr</span>
                                </td>
                                <td>
                                    <span class="badge" style="background:rgba(255,255,255,0.06)">v@(item.Version)</span>
                                </td>
                                <td>
                                    @(item.PublishedAt?.ToString("dd MMM yyyy · hh:mm tt") ?? "Pending publication")
                                </td>
                                @if (canManage)
                                {
                                    <td>
                                        <div class="row-actions justify-content-end">
                                            <a asp-action="Edit" asp-route-id="@item.Id" title="Edit result" aria-label="Edit">
                                                <i class="fa-regular fa-pen-to-square"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model" />
        </div>
    }
</div>
