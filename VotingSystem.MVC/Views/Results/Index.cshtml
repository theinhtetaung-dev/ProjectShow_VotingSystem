@model List<ResultResponseModel>
@{ ViewData["Title"] = "Results"; }
<div class="page-toolbar mb-3"><div><p class="eyebrow mb-1">Published outcomes</p><h1 class="h2 mb-0">Results</h1></div>@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-primary"><svg class="app-icon"><use href="#icon-plus" /></svg>Create result</a> }</div>
<partial name="_PageAlerts" />
@if (Model.Count == 0) { <div class="alert alert-info">No results found.</div> } else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Event ID</th><th>Project ID</th><th>Status</th><th>Version</th><th>Published</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Event ID">@item.EventId</td><td data-label="Project ID">@item.ProjectId</td><td data-label="Status"><span class="badge bg-secondary">@item.Status.ToString().Replace('_', ' ')</span></td><td data-label="Version">@item.Version</td><td data-label="Published">@(item.PublishedAt?.ToString("g") ?? "Not published")</td><td data-label="Action" class="table-actions text-end">@if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> }</td></tr> }</tbody></table></div> }
