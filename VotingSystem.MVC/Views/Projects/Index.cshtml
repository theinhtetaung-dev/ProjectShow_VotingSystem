@model List<ProjectResponseModel>
@{ ViewData["Title"] = "Projects"; }
<div class="page-toolbar mb-3"><div><p class="eyebrow mb-1">Management</p><h1 class="h2 mb-0">Projects</h1></div><a asp-action="Create" class="btn btn-primary"><svg class="app-icon"><use href="#icon-plus" /></svg>Create project</a></div>
<partial name="_PageAlerts" />
@if (Model.Count == 0) { <div class="alert alert-info">No projects found.</div> }
else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Project</th><th>Event ID</th><th>Type ID</th><th>Votes</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Project"><strong>@item.Name</strong><small class="table-subtitle">@(item.Description ?? "No description")</small></td><td data-label="Event ID">@item.EventId</td><td data-label="Type ID">@item.ProjectTypeId</td><td data-label="Votes">@item.VoteCounts</td><td data-label="Actions" class="table-actions text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }</tbody></table></div> }
