@model ProjectResponseModel
@{
    ViewData["Title"] = "Delete Project";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow text-danger">Workspace / Projects / Danger Zone</span>
            <h1 class="text-danger">Delete project</h1>
            <p>Confirm the removal of this project entry from the competition.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Cancel</span>
        </a>
    </div>

    <div class="panel material" style="border-color:rgba(251,113,133,0.3)">
        <h3 class="h5 mb-2">Are you sure you want to delete this project?</h3>
        <p class="text-sub mb-4">Project: <strong>@Model.Name</strong> · Category: <strong>@Model.ProjectTypeName</strong> · Event: <strong>@Model.EventCode</strong></p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"
              data-confirm-title="Delete project?" 
              data-confirm-message="Delete @Model.Name? Existing ballot records referencing this project will be affected." 
              data-confirm-button-text="Yes, delete project">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="fa-regular fa-trash-can"></i>
                <span>Delete project</span>
            </button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
