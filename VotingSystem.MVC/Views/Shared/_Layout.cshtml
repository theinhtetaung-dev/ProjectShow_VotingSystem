<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")NEXUS Vote</title>
    
    <!-- Google Fonts: Inter & Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Bootstrap 5 for Grid & Utilities -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- NEXUS UI Theme -->
    <link rel="stylesheet" href="~/css/nexus.css" asp-append-version="true" />
</head>
<body>
    <div class="ambient"></div>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var isSuperAdmin = User.IsInRole("SuperAdmin");
        var isAdmin = User.IsInRole("Admin");
        var username = User.Identity?.Name ?? "Operator";
        var initials = username.Length >= 2 ? username.Substring(0, 2).ToUpperInvariant() : username.ToUpperInvariant();
        var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    }

    @if (!isAuthenticated)
    {
        @RenderBody()
    }
    else
    {
        <div class="app is-active" id="app">
            <aside class="rail material" id="rail">
                <div class="brand">
                    <span class="brand-mark"><i class="fa-solid fa-n"></i></span>
                    <div class="brand-copy">
                        <strong>NEXUS</strong>
                        <small>VOTING ADMIN</small>
                    </div>
                </div>

                <nav class="nav" aria-label="Main navigation">
                    <div class="nav-group">Workspace</div>
                    <a class="nav-item @(currentController == "Home" ? "is-active" : null)" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-grid-2 fa-gauge-high"></i>
                        <span>Command center</span>
                    </a>
                    <a class="nav-item @(currentController == "Events" ? "is-active" : null)" asp-controller="Events" asp-action="Index">
                        <i class="fa-regular fa-calendar"></i>
                        <span>Events</span>
                    </a>
                    <a class="nav-item @(currentController == "Projects" ? "is-active" : null)" asp-controller="Projects" asp-action="Index">
                        <i class="fa-regular fa-folder-open"></i>
                        <span>Projects</span>
                    </a>
                    <a class="nav-item @(currentController == "ProjectTypes" ? "is-active" : null)" asp-controller="ProjectTypes" asp-action="Index">
                        <i class="fa-solid fa-shapes"></i>
                        <span>Project types</span>
                    </a>

                    @if (isSuperAdmin || isAdmin)
                    {
                        <div class="nav-group">Access control</div>
                        <a class="nav-item @(currentController == "Users" ? "is-active" : null)" asp-controller="Users" asp-action="Index">
                            <i class="fa-regular fa-user"></i>
                            <span>Users</span>
                        </a>
                        <a class="nav-item @(currentController == "EmailAccounts" ? "is-active" : null)" asp-controller="EmailAccounts" asp-action="Index">
                            <i class="fa-regular fa-envelope"></i>
                            <span>Email accounts</span>
                        </a>
                        @if (isSuperAdmin)
                        {
                            <a class="nav-item @(currentController == "Roles" ? "is-active" : null)" asp-controller="Roles" asp-action="Index">
                                <i class="fa-solid fa-user-shield"></i>
                                <span>Roles</span>
                            </a>
                            <a class="nav-item @(currentController == "Permissions" ? "is-active" : null)" asp-controller="Permissions" asp-action="Index">
                                <i class="fa-solid fa-key"></i>
                                <span>Permissions</span>
                            </a>
                            <a class="nav-item @(currentController == "RolePermissions" ? "is-active" : null)" asp-controller="RolePermissions" asp-action="Index">
                                <i class="fa-solid fa-shield-halved"></i>
                                <span>Role Permissions</span>
                            </a>
                        }
                    }

                    <div class="nav-group">Ballot</div>
                    <a class="nav-item @(currentController == "Votings" ? "is-active" : null)" asp-controller="Votings" asp-action="Index">
                        <i class="fa-solid fa-check-to-slot"></i>
                        <span>Voting</span>
                    </a>
                    <a class="nav-item @(currentController == "Results" ? "is-active" : null)" asp-controller="Results" asp-action="Index">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Results</span>
                    </a>
                </nav>

                <div class="rail-user">
                    <span class="avatar">@initials</span>
                    <div>
                        <strong>@username</strong>
                        <span>@roleName</span>
                    </div>
                </div>
            </aside>

            <div class="shell" id="shell">
                <header class="topbar">
                    <div class="top-left">
                        <button class="btn btn-icon btn-ghost" id="railToggle" type="button" aria-label="Toggle sidebar">
                            <i class="fa-solid fa-bars-staggered"></i>
                        </button>
                        <span class="crumb">Nexus / <b id="crumb">@(ViewData["Title"] ?? "Command center")</b></span>
                    </div>
                    <div class="top-actions">
                        <button class="btn btn-icon btn-ghost notification" type="button" aria-label="Notifications">
                            <i class="fa-regular fa-bell"></i>
                        </button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost user-label">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Sign out</span>
                            </button>
                        </form>
                    </div>
                </header>

                <main role="main">
                    @RenderBody()
                </main>

                <footer>
                    © @DateTime.Now.Year NEXUS Vote · Secure innovation decision infrastructure
                </footer>
            </div>
        </div>
    }

    <div class="tooltip" id="tooltip"></div>

    <partial name="_PageAlerts" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/notification-service.js" asp-append-version="true"></script>
    <script src="~/js/nexus.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
