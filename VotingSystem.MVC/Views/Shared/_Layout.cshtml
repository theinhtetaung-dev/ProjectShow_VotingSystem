<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voting System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VotingSystem.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar navbar-dark bg-dark d-lg-none px-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Voting System</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <aside class="sidebar offcanvas-lg offcanvas-start text-bg-dark" id="sidebar" tabindex="-1">
        <div class="offcanvas-header border-bottom border-secondary">
            <a class="fs-5 fw-semibold text-white text-decoration-none" asp-controller="Home" asp-action="Index">Voting System</a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <nav class="nav nav-pills flex-column gap-1">
                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link text-white" asp-controller="Events" asp-action="Index">Events</a>
                <a class="nav-link text-white" asp-controller="Projects" asp-action="Index">Projects</a>
                <a class="nav-link text-white" asp-controller="ProjectTypes" asp-action="Index">Project Types</a>
                <a class="nav-link text-white" asp-controller="Users" asp-action="Index">Users</a>
                <a class="nav-link text-white" asp-controller="Roles" asp-action="Index">Roles</a>
                <a class="nav-link text-white" asp-controller="Permissions" asp-action="Index">Permissions</a>
                <a class="nav-link text-white" asp-controller="RolePermissions" asp-action="Index">Role Permissions</a>
                <a class="nav-link text-white" asp-controller="Votings" asp-action="Index">Voting</a>
                <a class="nav-link text-white" asp-controller="Results" asp-action="Index">Results</a>
            </nav>
            <div class="mt-auto pt-3 border-top border-secondary">
                <a class="nav-link text-white" asp-controller="Account" asp-action="Index">Login / Logout</a>
            </div>
        </div>
    </aside>

    <div class="page-content">
        <main class="container-fluid p-3 p-md-4" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
