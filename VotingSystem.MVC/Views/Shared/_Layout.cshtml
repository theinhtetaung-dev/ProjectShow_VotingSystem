<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voting System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/VotingSystem.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var isSuperAdmin = User.IsInRole("SuperAdmin");
        var isAdmin = User.IsInRole("Admin");
    }
    <svg class="icon-sprite" aria-hidden="true">
        <symbol id="icon-mark" viewBox="0 0 24 24"><path d="M5 10.5 12 4l7 6.5v8.25c0 .69-.56 1.25-1.25 1.25H6.25C5.56 20 5 19.44 5 18.75V10.5Z"/><path d="m9 12 2 2 4-4"/></symbol>
        <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
        <symbol id="icon-dashboard" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="15" rx="2"/><path d="M8 3.5v4M16 3.5v4M3.5 10h17"/></symbol>
        <symbol id="icon-project" viewBox="0 0 24 24"><path d="M3.5 7.5h6l2-2h9v14h-17v-12Z"/></symbol>
        <symbol id="icon-layers" viewBox="0 0 24 24"><path d="m12 3.5 9 4.5-9 4.5L3 8l9-4.5Z"/><path d="m3 12 9 4.5 9-4.5M3 16l9 4.5 9-4.5"/></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20"/><circle cx="10" cy="8" r="3.5"/><path d="M16 5.2a3.5 3.5 0 0 1 0 6.6M18 15a3.5 3.5 0 0 1 3 3.5V20"/></symbol>
        <symbol id="icon-shield" viewBox="0 0 24 24"><path d="M12 3.5 20 7v5c0 4.5-3.1 7.5-8 9-4.9-1.5-8-4.5-8-9V7l8-3.5Z"/><path d="m9 12 2 2 4-4"/></symbol>
        <symbol id="icon-key" viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h8M17 12v3M20 12v3"/></symbol>
        <symbol id="icon-vote" viewBox="0 0 24 24"><path d="m8 4 8 2 1 7-8-2-1-7Z"/><path d="m10 7 2 2 3-3M5 13h14l1.5 7h-17L5 13Z"/></symbol>
        <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
        <symbol id="icon-account" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></symbol>
        <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="icon-eye" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></symbol>
        <symbol id="icon-edit" viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l1.2-5.2L16.5 3.5a1.4 1.4 0 0 1 2 0l2 2a1.4 1.4 0 0 1 0 2L9.2 18.8 4 20Z"/></symbol>
        <symbol id="icon-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6.5 7l1 13h9l1-13M10 11v5M14 11v5"/></symbol>
        <symbol id="icon-login" viewBox="0 0 24 24"><path d="M10 4H5v16h5M13 8l4 4-4 4M8 12h9"/></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
    </svg>
    @if (isAuthenticated)
    {
    <header class="mobile-header d-lg-none px-3">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="app-icon"><use href="#icon-mark" /></svg></span><span>Voting System</span></a>
        <button class="mobile-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open navigation">
            <svg class="app-icon"><use href="#icon-menu" /></svg>
        </button>
    </header>

    <aside class="sidebar offcanvas offcanvas-start text-white" id="sidebar" tabindex="-1" aria-label="Primary navigation">
        <div class="offcanvas-header sidebar-header">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="app-icon"><use href="#icon-mark" /></svg></span><span>Voting System<small>Administration</small></span></a>
            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
            <nav class="nav nav-pills flex-column gap-1">
                <a class="nav-link sidebar-link @(currentController == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index"><svg class="app-icon"><use href="#icon-dashboard" /></svg><span>Dashboard</span></a>
                @if (isSuperAdmin || isAdmin)
                {
                <span class="nav-section-label">Election management</span>
                <a class="nav-link sidebar-link @(currentController == "Events" ? "active" : null)" asp-controller="Events" asp-action="Index"><svg class="app-icon"><use href="#icon-calendar" /></svg><span>Events</span></a>
                <a class="nav-link sidebar-link @(currentController == "Projects" ? "active" : null)" asp-controller="Projects" asp-action="Index"><svg class="app-icon"><use href="#icon-project" /></svg><span>Projects</span></a>
                <a class="nav-link sidebar-link @(currentController == "ProjectTypes" ? "active" : null)" asp-controller="ProjectTypes" asp-action="Index"><svg class="app-icon"><use href="#icon-layers" /></svg><span>Project Types</span></a>
                <a class="nav-link sidebar-link @(currentController == "Users" ? "active" : null)" asp-controller="Users" asp-action="Index"><svg class="app-icon"><use href="#icon-users" /></svg><span>Users</span></a>
                }
                @if (isSuperAdmin)
                {
                <span class="nav-section-label">Access control</span>
                <a class="nav-link sidebar-link @(currentController == "Roles" ? "active" : null)" asp-controller="Roles" asp-action="Index"><svg class="app-icon"><use href="#icon-shield" /></svg><span>Roles</span></a>
                <a class="nav-link sidebar-link @(currentController == "Permissions" ? "active" : null)" asp-controller="Permissions" asp-action="Index"><svg class="app-icon"><use href="#icon-key" /></svg><span>Permissions</span></a>
                <a class="nav-link sidebar-link @(currentController == "RolePermissions" ? "active" : null)" asp-controller="RolePermissions" asp-action="Index"><svg class="app-icon"><use href="#icon-shield" /></svg><span>Role Permissions</span></a>
                }
                <span class="nav-section-label">Participation</span>
                <a class="nav-link sidebar-link @(currentController == "Votings" ? "active" : null)" asp-controller="Votings" asp-action="Index"><svg class="app-icon"><use href="#icon-vote" /></svg><span>Voting</span></a>
                <a class="nav-link sidebar-link @(currentController == "Results" ? "active" : null)" asp-controller="Results" asp-action="Index"><svg class="app-icon"><use href="#icon-chart" /></svg><span>Results</span></a>
            </nav>
            <div class="mt-auto pt-3 border-top border-secondary">
                <div class="sidebar-user"><strong>@User.Identity?.Name</strong><small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-link sidebar-link sidebar-button"><svg class="app-icon"><use href="#icon-login" /></svg><span>Sign out</span></button>
                </form>
            </div>
        </div>
    </aside>
    }

    <div class="page-content @(isAuthenticated ? null : "page-content-public")">
        @if (isAuthenticated)
        {
        <div class="desktop-topbar d-none d-lg-flex">
            <div class="breadcrumb-line" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a>@if (currentController != "Home") { <svg class="app-icon"><use href="#icon-chevron" /></svg><span>@ViewData["Title"]</span> }</div>
            <div class="topbar-account"><span class="account-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")</span><span><strong>@User.Identity?.Name</strong><small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small></span></div>
        </div>
        }
        <main class="container-fluid p-3 p-md-4" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
