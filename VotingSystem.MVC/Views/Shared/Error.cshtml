@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<span hidden data-swal-notification data-swal-icon="error" data-swal-title="Something went wrong" data-swal-message="An unexpected error occurred while processing your request. Please try again."></span>

<div class="d-flex justify-content-center align-items-center" style="min-height:70vh">
    <div class="panel material text-center p-5" style="max-width:540px;border-color:rgba(251,113,133,0.3)">
        <div class="stat-icon mx-auto mb-3" style="width:54px;height:54px;font-size:22px;background:rgba(251,113,133,0.12);color:var(--danger)">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <span class="eyebrow text-danger">Fault detected</span>
        <h1 class="h3 my-2 text-white">System Error</h1>
        <p class="text-sub small mb-4">An unexpected fault occurred during pipeline execution. Check system logs for detailed diagnostics.</p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="p-2 mb-4 rounded bg-dark border border-secondary-subtle">
                <span class="text-muted small">Diagnostic Trace ID:</span>
                <code class="text-info font-monospace ms-1">@Model.RequestId</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fa-solid fa-house"></i>
                <span>Return to command center</span>
            </a>
        </div>
    </div>
</div>
