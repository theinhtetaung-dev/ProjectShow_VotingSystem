@model dynamic
@{
    if (Model == null) return;
    int total = (int)Model.TotalPages;
    int pageNum = (int)Model.PageNumber;
    int pageSize = (int)Model.PageSize;
    int totalCount = (int)Model.TotalCount;
    bool hasPrevious = (bool)Model.HasPreviousPage;
    bool hasNext = (bool)Model.HasNextPage;
    if (total <= 0) return;
    int current = Math.Clamp(pageNum, 1, Math.Max(1, total));
    var pages = Enumerable.Range(Math.Max(1, current - 2), Math.Min(total, current + 2) - Math.Max(1, current - 2) + 1);
    int startItem = totalCount > 0 ? (current - 1) * pageSize + 1 : 0;
    int endItem = Math.Min(totalCount, current * pageSize);
}

<div class="pager">
    <span>
        @if (totalCount > 0)
        {
            <text>Showing @startItem–@endItem of @totalCount records</text>
        }
        else
        {
            <text>No records found</text>
        }
    </span>
    @if (total > 1)
    {
        <div class="pages">
            @if (hasPrevious)
            {
                <a asp-route-pageNumber="@(pageNum - 1)" asp-route-pageSize="@pageSize" asp-route-status="@ViewBag.SelectedStatus" aria-label="Previous page">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            }
            else
            {
                <a href="javascript:void(0)" class="disabled" aria-disabled="true">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            }

            @foreach (var pageIndex in pages)
            {
                if (pageIndex == current)
                {
                    <span class="active" aria-current="page">@pageIndex</span>
                }
                else
                {
                    <a asp-route-pageNumber="@pageIndex" asp-route-pageSize="@pageSize" asp-route-status="@ViewBag.SelectedStatus">@pageIndex</a>
                }
            }

            @if (hasNext)
            {
                <a asp-route-pageNumber="@(pageNum + 1)" asp-route-pageSize="@pageSize" asp-route-status="@ViewBag.SelectedStatus" aria-label="Next page">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
            else
            {
                <a href="javascript:void(0)" class="disabled" aria-disabled="true">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
        </div>
    }
</div>
