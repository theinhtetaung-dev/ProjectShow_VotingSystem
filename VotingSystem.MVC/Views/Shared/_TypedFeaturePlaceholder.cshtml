@using System.Text.Json
@model object
@{
    var modalId = $"requestDataModal-{Guid.NewGuid():N}";
}
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="modal fade request-data-modal"
     id="@modalId"
     tabindex="-1"
     aria-labelledby="@(modalId)-label"
     aria-hidden="true"
     data-request-data-modal
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="@(modalId)-label">Request data</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body data-preview">
                <pre class="mb-0">@JsonSerializer.Serialize(Model, new JsonSerializerOptions { WriteIndented = true })</pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
