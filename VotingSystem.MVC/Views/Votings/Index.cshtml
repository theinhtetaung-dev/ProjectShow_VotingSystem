@model List<VotingResponseModel>
@{ ViewData["Title"] = "Voting"; }
<div class="page-header mb-3"><div><p class="eyebrow mb-1">Election activity</p><h1 class="h2 mb-0">Voting</h1></div></div>
<partial name="_PageAlerts" />
<form asp-action="Vote" method="post" class="inline-operation mb-4"><div><label class="form-label">User Event ID</label><input name="UserEventId" type="number" min="1" class="form-control" required /></div><div><label class="form-label">Project ID</label><input name="ProjectId" type="number" min="1" class="form-control" required /></div><button type="submit" class="btn btn-primary">Cast vote</button></form>
@if (Model.Count == 0) { <div class="alert alert-info">No voting records found.</div> } else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Vote ID</th><th>User Event ID</th><th>Project ID</th><th>Voted at</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Vote ID">@item.Id</td><td data-label="User Event ID">@item.UserEventId</td><td data-label="Project ID">@item.ProjectId</td><td data-label="Voted at">@item.VotedAt.ToString("g")</td></tr> }</tbody></table></div> }
