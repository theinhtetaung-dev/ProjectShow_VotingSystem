@model PageResult<VotingResponseModel>
@{
    ViewData["Title"] = "Voting";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Ballot / Voting</span>
            <h1>Cast vote &amp; ballot records</h1>
            <p>Submit cryptographic participation votes and review verified ledger ballots.</p>
        </div>
    </div>

    <!-- Cast Vote Operation Card -->
    <div class="panel material mb-4">
        <div class="card-head">
            <div class="d-flex align-items-center gap-3">
                <span class="stat-icon" style="background:rgba(14,165,233,0.12);color:var(--brand2);width:38px;height:38px">
                    <i class="fa-solid fa-check-to-slot"></i>
                </span>
                <div>
                    <h3 class="mb-0">Cast verified ballot</h3>
                    <p class="text-muted small">Enter your assigned participation ID and candidate project ID.</p>
                </div>
            </div>
            <span class="badge active-b">Live ballot open</span>
        </div>

        <form asp-action="Vote" method="post" class="row g-3 align-items-end mt-1" 
              data-confirm-title="Submit this ballot?" 
              data-confirm-message="Please verify your Participation and Project IDs. Once cast, this ballot is permanently recorded." 
              data-confirm-button-text="Yes, confirm vote">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label" for="userEventId">Participation ID (UserEventId)</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-id-card"></i>
                    <input id="userEventId" name="UserEventId" type="number" min="1" class="input" placeholder="e.g. 1024" required />
                </div>
            </div>

            <div class="col-md-5">
                <label class="form-label" for="projectId">Project ID (Candidate)</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-layer-group"></i>
                    <input id="projectId" name="ProjectId" type="number" min="1" class="input" placeholder="e.g. 18" required />
                </div>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100" style="height:44px">
                    <i class="fa-solid fa-check"></i>
                    <span>Confirm vote</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Voting Records -->
    <div class="card-head mt-4 mb-2">
        <div>
            <h3>Audit ledger &amp; voting records</h3>
            <p>Chronological stream of verified participant ballots.</p>
        </div>
    </div>

    @if (Model == null || Model.Items.Count == 0)
    {
        <div class="panel material text-center p-5">
            <i class="fa-solid fa-box-archive fa-2x mb-3 text-muted"></i>
            <h3 class="h5 mb-2">No ballots recorded yet</h3>
            <p class="text-muted small">Cast your ballot using the form above to record your vote.</p>
        </div>
    }
    else
    {
        <div class="table-shell material">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Vote ID</th>
                            <th>Participation ID</th>
                            <th>Project ID</th>
                            <th>Submitted time</th>
                            <th>Verification</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>#@item.Id</strong>
                                </td>
                                <td>
                                    <span class="badge" style="font-family:monospace">ID: @item.UserEventId</span>
                                </td>
                                <td>
                                    <span class="badge active-b">Project #@item.ProjectId</span>
                                </td>
                                <td>
                                    @item.VotedAt.ToString("dd MMM yyyy · hh:mm tt")
                                </td>
                                <td>
                                    <span class="badge published-b"><i class="fa-solid fa-shield-halved me-1"></i> Verified</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model" />
        </div>
    }
</div>
