@model LoginRequestModel
@{
    ViewData["Title"] = "Authenticate";
}

<section class="login-screen" id="loginScreen">
    <div class="login-world">
        <div class="brand">
            <span class="brand-mark"><i class="fa-solid fa-n"></i></span>
            <div class="brand-copy">
                <strong>NEXUS VOTE</strong>
                <small>INNOVATION CONTROL</small>
            </div>
        </div>

        <div class="world-copy">
            <span class="eyebrow">Build · Decide · Advance</span>
            <h1>Where bold ideas<br><span>earn their orbit.</span></h1>
            <p>A precision voting environment for the teams shaping tomorrow in software, hardware, artificial intelligence and cybersecurity.</p>
        </div>

        <div class="orbit-scene" aria-hidden="true">
            <div class="orbit"><span class="sat"></span></div>
            <div class="orbit two"><span class="sat"></span></div>
            <div class="core"></div>
        </div>

        <div class="signal-row">
            <span class="signal"><i class="fa-solid fa-code" style="color:var(--blue)"></i>Software</span>
            <span class="signal"><i class="fa-solid fa-microchip" style="color:var(--orange)"></i>Hardware</span>
            <span class="signal"><i class="fa-solid fa-brain" style="color:var(--purple)"></i>AI</span>
            <span class="signal"><i class="fa-solid fa-shield-halved" style="color:var(--cyan)"></i>Cybersecurity</span>
        </div>
    </div>

    <div class="login-panel">
        <div class="login-card">
            <div class="brand mobile-brand mb-4">
                <span class="brand-mark"><i class="fa-solid fa-n"></i></span>
                <div class="brand-copy">
                    <strong>NEXUS VOTE</strong>
                    <small>INNOVATION CONTROL</small>
                </div>
            </div>

            <span class="eyebrow">Secure operator access</span>
            <h2>Enter the control room.</h2>
            <p>Use your administrator or operator credentials to continue.</p>

            <form class="login-form" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                
                <div class="field">
                    <label asp-for="Email">Work email</label>
                    <div class="input-wrap">
                        <i class="fa-regular fa-envelope"></i>
                        <input asp-for="Email" class="input" type="email" placeholder="e.g. aungminkhant@gmail.com" required autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" class="input" type="password" placeholder="Enter your password" required autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-meta">
                    <label class="check">
                        <input type="checkbox" name="RememberMe" value="true" checked /> Keep me signed in
                    </label>
                    <span class="text-muted small">Standard demo: Thanks!12@@</span>
                </div>

                <button class="btn btn-primary login-submit" type="submit">
                    <span>Authenticate</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="secure-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Encrypted session · administrator gateway</span>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
