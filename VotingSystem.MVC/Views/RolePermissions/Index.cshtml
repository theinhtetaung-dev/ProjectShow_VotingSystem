@model PageResult<RolePermissionResponseModel>
@{
    ViewData["Title"] = "Role Permissions";
}

<div class="view is-active">
    <div class="page-head">
        <div>
            <span class="eyebrow">Access Control / Matrix</span>
            <h1>Role permissions</h1>
            <p>Map permissions to administrative security roles.</p>
        </div>
    </div>

    <!-- Assignment Form -->
    <div class="panel material mb-4">
        <div class="card-head">
            <div>
                <h3 class="mb-0">Assign capability to role</h3>
                <p class="text-muted small">Bind a security permission token to a specific role ID.</p>
            </div>
        </div>

        <form asp-action="Assign" method="post" class="row g-3 align-items-end mt-1">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label" for="roleId">Role ID</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-user-shield"></i>
                    <input id="roleId" name="RoleId" type="number" min="1" class="input" placeholder="e.g. 2" required />
                </div>
            </div>

            <div class="col-md-5">
                <label class="form-label" for="permissionId">Permission ID</label>
                <div class="input-wrap">
                    <i class="fa-solid fa-key"></i>
                    <input id="permissionId" name="PermissionId" type="number" min="1" class="input" placeholder="e.g. 5" required />
                </div>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100" style="height:44px">
                    <i class="fa-solid fa-link"></i>
                    <span>Assign</span>
                </button>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Items.Count == 0)
    {
        <div class="panel material text-center p-5">
            <i class="fa-solid fa-shield-halved fa-2x mb-3 text-muted"></i>
            <h3 class="h5 mb-2">No mappings found</h3>
            <p class="text-muted small">Assign permissions to roles to enable capabilities.</p>
        </div>
    }
    else
    {
        <div class="table-shell material">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Security Role</th>
                            <th>Permission Capability</th>
                            <th>Code</th>
                            <th>Assigned time</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge" style="background:rgba(14,165,233,0.1);color:var(--brand2)">@item.RoleName</span>
                                </td>
                                <td>
                                    <strong>@item.PermissionName</strong>
                                </td>
                                <td>
                                    <span class="badge" style="font-family:monospace">@item.PermissionCode</span>
                                </td>
                                <td>
                                    @item.AssignedAt.ToString("dd MMM yyyy · hh:mm tt")
                                </td>
                                <td>
                                    <div class="row-actions justify-content-end">
                                        <form asp-action="Remove" method="post" 
                                              data-confirm-title="Remove permission?" 
                                              data-confirm-message="Revoke this permission mapping from @item.RoleName?" 
                                              data-confirm-button-text="Yes, revoke">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RoleId" value="@item.RoleId" />
                                            <input type="hidden" name="PermissionId" value="@item.PermissionId" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Remove permission">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model" />
        </div>
    }
</div>
