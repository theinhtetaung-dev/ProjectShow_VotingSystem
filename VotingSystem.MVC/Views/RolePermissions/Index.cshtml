@model PageResult<RolePermissionResponseModel>
@{ ViewData["Title"] = "Role Permissions"; }
<div class="page-header mb-3"><div><p class="eyebrow mb-1">Authorization</p><h1 class="h2 mb-0">Role Permissions</h1></div></div>
<partial name="_PageAlerts" />
<form asp-action="Assign" method="post" class="inline-operation mb-4"><div><label class="form-label">Role ID</label><input name="RoleId" type="number" min="1" class="form-control" required /></div><div><label class="form-label">Permission ID</label><input name="PermissionId" type="number" min="1" class="form-control" required /></div><button type="submit" class="btn btn-primary">Assign permission</button></form>
@if (Model.Count == 0) { <div class="alert alert-info">No role permissions found.</div> } else { <div class="table-responsive mobile-table-shell"><table class="table table-hover align-middle mobile-card-table"><thead><tr><th>Role</th><th>Permission</th><th>Code</th><th>Assigned</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td data-label="Role"><strong>@item.RoleName</strong></td><td data-label="Permission">@item.PermissionName</td><td data-label="Code"><span class="code-label">@item.PermissionCode</span></td><td data-label="Assigned">@item.AssignedAt.ToString("g")</td><td data-label="Action" class="table-actions text-end"><form asp-action="Remove" method="post"><input type="hidden" name="RoleId" value="@item.RoleId" /><input type="hidden" name="PermissionId" value="@item.PermissionId" /><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form></td></tr> }</tbody></table></div> }
<partial name="_Pagination" model="Model" />
